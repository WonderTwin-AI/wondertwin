#!/usr/bin/env python3
"""Behavioural test for scripts/check-governance.

WHY THIS EXISTS. The case-insensitive `Skill: none` check landed once, was
silently reverted a day later by a hand-sync between two copies of this
script, and nothing caught it. The reverting commit asserted "the mechanism is
unchanged". A fix with no executable guard survived less than 24 hours, and
the failure was a gate that passes an unreasoned citation: it fails open,
which is the direction that leaves no trace.

Builds throwaway git repos and drives the real script. Source-text assertions
would not have caught the revert, because the reverted file still contained
the word "none".

This file is copied verbatim into every emulator repo alongside the script it
tests. Keep them byte-identical.

Runs every case, then exits 0 when all of them behave and 1 when any did not.
"""

from __future__ import annotations

import importlib.util
import os
import re
import shutil
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

CHECK = Path(__file__).resolve().parent / "check-governance"


def _gate():
    loader = SourceFileLoader("check_governance", str(CHECK))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


KIT_DIR = re.compile(f"^{_gate().KIT_DIR}$")
# The throwaway repos have to be throwaway. Ambient config reaches into them
# otherwise: commit.gpgsign with an unusable key, or a global core.hooksPath
# with a failing pre-commit, makes setup exit non-zero and the whole harness
# reports "setup failed" for a reason that has nothing to do with the gate.
ENV = {
    **os.environ,
    "GIT_CONFIG_GLOBAL": os.devnull,
    "GIT_CONFIG_SYSTEM": os.devnull,
}
FAILED = []


def sh(cwd, *args):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, env=ENV)
    if r.returncode != 0:
        # Setup breakage is a broken harness, not a case result. A silent
        # failure here leaves `main...HEAD` empty, and every case that wants
        # exit 0 then reports ok down the "no emulator touched" path.
        sys.exit(
            f"test-check-governance: setup failed ({' '.join(args)}) "
            f"exit {r.returncode}\n{r.stdout}{r.stderr}"
        )


def repo(tmp: str) -> Path:
    root = Path(tmp)
    (root / "scripts").mkdir(parents=True)
    shutil.copy2(CHECK, root / "scripts" / "check-governance")
    sh(root, "git", "init", "-q", "-b", "main")
    sh(root, "git", "config", "user.email", "t@example.com")
    sh(root, "git", "config", "user.name", "T")
    (root / "README.md").write_text("base\n")
    sh(root, "git", "add", "-A")
    sh(root, "git", "commit", "-qm", "base")
    # The change has to live on a branch off main. Committing onto main itself
    # makes `main...HEAD` empty, so every case reads as "no emulator touched"
    # and passes for the wrong reason. That mistake produced one false ok here.
    sh(root, "git", "checkout", "-q", "-b", "work")
    return root


BOT = "dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>"


def change(root: Path, paths, message: str, author=None):
    for rel in paths:
        p = root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text("x\n")
    sh(root, "git", "add", "-A")
    extra = ["--author", author] if author else []
    sh(root, "git", "commit", "-qm", message, *extra)


GITHUB = "GitHub <noreply@github.com>"


def merge_main(root: Path, paths, message: str, author: str):
    """Merge a new main commit into the branch, as GitHub's PR merge ref does.

    `paths` are written into the merge commit itself, so a merge can carry
    changes that no non-merge commit in the range made.
    """
    sh(root, "git", "checkout", "-q", "main")
    change(root, ["docs/upstream.md"], "upstream")
    sh(root, "git", "checkout", "-q", "work")
    sh(root, "git", "merge", "-q", "--no-ff", "--no-commit", "main")
    change(root, paths, message, author)


def run(root: Path, pr_author=None):
    env = {k: v for k, v in ENV.items() if k != "GOVERNANCE_PR_AUTHOR"}
    if pr_author:
        env["GOVERNANCE_PR_AUTHOR"] = pr_author
    return subprocess.run(
        [sys.executable, str(root / "scripts" / "check-governance"), "main", "HEAD"],
        cwd=root, capture_output=True, text=True, env=env,
    )


def shared_kit() -> str:
    """The shared kit directory this repo actually has.

    Pinning the real name is the point. SHARED_DIR used to carry a guessed
    alias for the post-CTO-56 name, which reads as a naming decision nobody
    made. Asserting against the directory on disk means a rename fails here
    instead of silently making kit changes stop counting as fleet-shaped,
    which is a gate that quietly narrows rather than one that breaks.
    """
    root = Path(__file__).resolve().parent.parent
    kits = sorted(
        p.name for p in root.iterdir() if p.is_dir() and KIT_DIR.match(p.name)
    )
    if not kits:
        sys.exit(
            "test-check-governance: KIT_DIR in check-governance matches no "
            "directory in this repo; if the kit was renamed, update KIT_DIR"
        )
    return kits[0]


def case(label, paths, message, want_rc, *want_text,
         commits=None, pr_author=None):
    """`commits` overrides the single change: a list of (paths, message, author),
    with an optional fourth element True to make that step a merge of main."""
    with tempfile.TemporaryDirectory() as tmp:
        root = repo(tmp)
        for c_paths, c_msg, c_author, *merge in commits or [(paths, message, None)]:
            step = merge_main if merge and merge[0] else change
            step(root, c_paths, c_msg, c_author)
        r = run(root, pr_author)
        out = r.stdout + r.stderr
        if r.returncode != want_rc:
            print(f"FAIL {label}: exit {r.returncode}, wanted {want_rc}\n{out}")
            FAILED.append(label); return
        for want in want_text:
            if want not in out:
                print(f"FAIL {label}: output missing {want!r}\n{out}")
                FAILED.append(label); return
        print(f"ok   {label}")


def main():
    case("one emulator needs no citation",
         ["twin-alpha/a.txt"], "touch one", 0, "not fleet-shaped")
    case("two emulators without a citation fail",
         ["twin-alpha/a.txt", "twin-beta/b.txt"], "touch two", 1,
         "no `Skill:`", "Skill: sweep-fleet-hygiene")
    case("two emulators with a citation pass",
         ["twin-alpha/a.txt", "twin-beta/b.txt"],
         "touch two\n\nSkill: sweep-fleet-hygiene", 0, "governed by")
    case("a reasoned none passes",
         ["twin-alpha/a.txt", "twin-beta/b.txt"],
         "touch two\n\nSkill: none (single-vendor SDK bump)", 0, "governed by")
    # The regression. Each of these reverted once and shipped as passing.
    case("bare none is rejected",
         ["twin-alpha/a.txt", "twin-beta/b.txt"],
         "touch two\n\nSkill: none", 1, "must carry a reason")
    case("capitalised None is rejected",
         ["twin-alpha/a.txt", "twin-beta/b.txt"],
         "touch two\n\nSkill: None", 1, "must carry a reason")
    case("upper-case NONE is rejected",
         ["twin-alpha/a.txt", "twin-beta/b.txt"],
         "touch two\n\nSkill: NONE", 1, "must carry a reason")
    # Fleet-shaped by reach: the kit is shared, whatever it is called here.
    case("a shared kit change alone is fleet-shaped",
         ["twinkit/state.go"], "touch the kit", 1, "shared")
    case("a shared pro kit change alone is fleet-shaped",
         ["twinkit-pro/state.go"], "touch the pro kit", 1, "shared")
    case("the kit in THIS repo is recognised as shared",
         [f"{shared_kit()}/probe.go"], "touch this repo's kit", 1, "shared")
    case("a shared schema change alone is fleet-shaped",
         ["schemas/twin.schema.json"], "touch the schemas", 1, "shared")
    case("an unrelated file needs no citation",
         ["docs/notes.md"], "unrelated", 0, "not fleet-shaped")
    # Dependabot cannot write a trailer. Its PRs pass only when GitHub says the
    # PR is Dependabot's AND every commit is; each half alone must not pass.
    two = ["twin-alpha/go.mod", "twin-beta/go.mod"]
    case("a Dependabot PR needs no citation",
         None, None, 0, "Dependabot",
         commits=[(two, "chore(deps): bump", BOT)], pr_author="dependabot[bot]")
    case("a Dependabot kit bump needs no citation",
         None, None, 0, "Dependabot",
         commits=[(["twinkit/go.mod"], "chore(deps): bump", BOT)],
         pr_author="dependabot[bot]")
    case("a forged Dependabot author without the PR event fails",
         None, None, 1, "no `Skill:`",
         commits=[(two, "chore(deps): bump", BOT)])
    case("a human PR claiming the Dependabot author fails",
         None, None, 1, "no `Skill:`",
         commits=[(two, "chore(deps): bump", BOT)], pr_author="someone")
    case("a human commit on a Dependabot PR needs a citation",
         None, None, 1, "no `Skill:`",
         commits=[(two, "chore(deps): bump", BOT),
                  (["twin-gamma/x.go"], "fix build", None)],
         pr_author="dependabot[bot]")
    case("a cited human commit on a Dependabot PR passes",
         None, None, 0, "governed by",
         commits=[(two, "chore(deps): bump", BOT),
                  (["twin-gamma/x.go"],
                   "fix build\n\nSkill: none (follow-up to a dependency bump)",
                   None)],
         pr_author="dependabot[bot]")
    case("a Dependabot PR under GitHub's merge commit needs no citation",
         None, None, 0, "Dependabot",
         commits=[(two, "chore(deps): bump", BOT),
                  ([], "Merge main into work", GITHUB, True)],
         pr_author="dependabot[bot]")
    case("a merge-only range on a Dependabot PR needs a citation",
         None, None, 1, "no `Skill:`",
         commits=[(two, "Merge main into work", BOT, True)],
         pr_author="dependabot[bot]")

    if FAILED:
        print(f"test-check-governance: {len(FAILED)} failed")
        sys.exit(1)
    print("test-check-governance: pass")


if __name__ == "__main__":
    main()
