#!/usr/bin/env python3
"""Require a governing skill on fleet-shaped changes.

THE FAILURE THIS EXISTS FOR. On 2026-08-28 an agent ran a four-emulator
remediation sweep and shipped it while sweep-fleet-hygiene,
synthesise-batch sat unused, and the umbrella-tracker-issue discipline with
them.
Nothing was wrong with the library. The problem was that nothing made the
sweep discoverable at the moment it was needed, and nothing recorded that it
had not been used, so the omission left no trace to review.

WHY A CITATION AND NOT A PROMPT. A prompt is advice and advice loses to time
pressure. A citation is a fact in the commit, which means the gate and any
later reader can audit which skill governed a change. It rides as a git
trailer mechanically; "skill citation" is what to call it in prose, because
"trailer" names the transport rather than the thing. Auditable is the
requirement; blocked is not. `Skill: none` with a reason passes, because a
recorded decision satisfies the requirement while an unrecordable rule just
teaches people to route around it.

WHY THE THRESHOLD IS TWO. The motivating sweep touched four emulators. A
threshold tuned just under the incident teaches contributors to split a PR
until it slips through, which converts a safety rule into a formatting
exercise. Two is where "this change is about one emulator" stops being true.

Usage:  scripts/check-governance <base-ref> [head-ref]
"""

import re
import subprocess
import sys

THRESHOLD = 2
EMULATOR_DIR = re.compile(r"^(twin-[a-z0-9-]+)/")
CITATION = re.compile(r"^Skill:\s*(\S.*)$", re.MULTILINE)
SHARED = ("twinkit/", "schemas/")


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout


def main() -> int:
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip().splitlines()[-1])
    base = sys.argv[1]
    head = sys.argv[2] if len(sys.argv) > 2 else "HEAD"

    files = [f for f in git("diff", "--name-only", f"{base}...{head}").split() if f]
    emulators = sorted({m.group(1) for f in files if (m := EMULATOR_DIR.match(f))})
    shared = sorted({p for f in files for p in SHARED if f.startswith(p)})

    # A change to twinkit or the schemas reaches every emulator whether or not
    # it edits their directories, so it is fleet-shaped by reach, not by count.
    fleet = len(emulators) >= THRESHOLD or bool(shared)
    if not fleet:
        scope = emulators[0] if emulators else "no emulator"
        print(f"check-governance: not fleet-shaped ({scope}); no skill citation required")
        return 0

    body = git("log", "--format=%B", f"{base}..{head}")
    citations = [t.strip() for t in CITATION.findall(body)]

    why = f"{len(emulators)} emulator(s)" if len(emulators) >= THRESHOLD else ""
    if shared:
        why = ", ".join(filter(None, [why, f"shared: {' '.join(shared)}"]))

    if not citations:
        print(
            f"check-governance: FAIL, fleet-shaped change ({why}) with no "
            f"`Skill:` citation.\n"
            f"  Emulators touched: {' '.join(emulators) or '(none directly)'}\n"
            f"  Add a skill citation naming the skill that governed this change, e.g.\n"
            f"    Skill: sweep-fleet-hygiene\n"
            f"  If no skill applies, say so and why:\n"
            f"    Skill: none (reason)"
        )
        return 1

    print(f"check-governance: fleet-shaped ({why}), governed by:")
    for t in citations:
        print(f"  {t}")
    unreasoned = [t for t in citations if t.split()[0] == "none" and "(" not in t]
    if unreasoned:
        print("check-governance: FAIL, `Skill: none` must carry a reason in parens")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
