#!/usr/bin/env python3
"""Require a governing skill on fleet-shaped changes.

THE FAILURE THIS EXISTS FOR. On 2026-08-28 an agent ran a four-emulator
remediation sweep and shipped it while sweep-fleet-hygiene,
synthesise-batch sat unused, and the umbrella-tracker-issue discipline with
them.
Nothing was wrong with the library. The problem was that nothing made the
sweep discoverable at the moment it was needed, and nothing recorded that it
had not been used, so the omission left no trace to review.

WHY A CITATION AND NOT A PROMPT. A prompt is advice and advice loses to time
pressure. A citation is a fact in the commit, which means the gate and any
later reader can audit which skill governed a change. It rides as a git
trailer mechanically; "skill citation" is what to call it in prose, because
"trailer" names the transport rather than the thing. Auditable is the
requirement; blocked is not. `Skill: none` with a reason passes, because a
recorded decision satisfies the requirement while an unrecordable rule just
teaches people to route around it.

WHY THE THRESHOLD IS TWO. The motivating sweep touched four emulators. A
threshold tuned just under the incident teaches contributors to split a PR
until it slips through, which converts a safety rule into a formatting
exercise. Two is where "this change is about one emulator" stops being true.

Usage:  scripts/check-governance <base-ref> [head-ref]
"""

import os
import re
import subprocess
import sys

THRESHOLD = 2
EMULATOR_DIR = re.compile(r"^(twin-[a-z0-9-]+)/")
CITATION = re.compile(r"^Skill:\s*(\S.*)$", re.MULTILINE)
# Derived, not listed. This file is copied verbatim into every emulator repo,
# and the one line that used to differ (which kit is "shared" here) was the
# line that had to be reconciled by hand on every change. It was mis-reconciled
# twice in two days, once losing the case-insensitive `none` check below. A
# pattern resolves correctly in each repo, so the copies are byte-identical and
# any divergence is a plain diff.
#
# It does NOT pre-name the post-rename kit. CTO-56 has not settled the naming
# scheme, so an alias for a guessed name would read as a decision that was
# never made. The guard is the test instead: it asserts this pattern matches a
# shared kit directory that actually exists in the repo, so a rename fails
# loudly here rather than quietly ceasing to treat kit changes as fleet-shaped.
KIT_DIR = r"twinkit[a-z-]*"
SHARED_DIR = re.compile(rf"^({KIT_DIR}|schemas)/")
# Dependabot cannot write a commit trailer, so without this every grouped
# dependency bump that reaches the kit or two emulators failed the gate and
# routine dependency updates stopped merging. A Dependabot PR is its own record:
# the bot, the manifests and the versions are all in the PR.
#
# The exemption needs BOTH signals. Commit authorship alone is forgeable by
# anyone with `git commit --author`; the PR author comes from the GitHub event
# (CI passes it as GOVERNANCE_PR_AUTHOR), so a contributor opening their own PR
# cannot claim it. A commit under its own author on a Dependabot branch puts
# the PR back under the citation rule. Someone with write access could still
# push a commit with a forged Dependabot author onto a Dependabot branch; that
# is acceptable because this gate is an audit record, not a security boundary.
#
# Merge commits do not count as authors. In CI, HEAD is the merge commit GitHub
# synthesises for the PR, and a branch may merge main in; neither is a change
# anyone authored here. A range with no non-merge commits is never exempt.
BOT_LOGIN = "dependabot[bot]"
BOT_EMAIL = "49699333+dependabot[bot]@users.noreply.github.com"


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout


def main() -> int:
    if len(sys.argv) < 2:
        sys.exit(__doc__.strip().splitlines()[-1])
    base = sys.argv[1]
    head = sys.argv[2] if len(sys.argv) > 2 else "HEAD"

    files = [f for f in git("diff", "--name-only", f"{base}...{head}").split() if f]
    emulators = sorted({m.group(1) for f in files if (m := EMULATOR_DIR.match(f))})
    shared = sorted({m.group(1) + "/" for f in files if (m := SHARED_DIR.match(f))})

    # A change to twinkit or the schemas reaches every emulator whether or not
    # it edits their directories, so it is fleet-shaped by reach, not by count.
    fleet = len(emulators) >= THRESHOLD or bool(shared)
    if not fleet:
        scope = emulators[0] if emulators else "no emulator"
        print(f"check-governance: not fleet-shaped ({scope}); no skill citation required")
        return 0

    authors = set(
        git("log", "--no-merges", "--format=%ae", f"{base}..{head}").split()
    )
    if (
        os.environ.get("GOVERNANCE_PR_AUTHOR") == BOT_LOGIN
        and authors == {BOT_EMAIL}
    ):
        print(
            "check-governance: fleet-shaped, governed by:\n"
            "  none (automated Dependabot dependency update; "
            "every commit is Dependabot's)"
        )
        return 0

    body = git("log", "--format=%B", f"{base}..{head}")
    citations = [t.strip() for t in CITATION.findall(body)]

    why = f"{len(emulators)} emulator(s)" if len(emulators) >= THRESHOLD else ""
    if shared:
        why = ", ".join(filter(None, [why, f"shared: {' '.join(shared)}"]))

    if not citations:
        print(
            f"check-governance: FAIL, fleet-shaped change ({why}) with no "
            f"`Skill:` citation.\n"
            f"  Emulators touched: {' '.join(emulators) or '(none directly)'}\n"
            f"  Add a skill citation naming the skill that governed this change, e.g.\n"
            f"    Skill: sweep-fleet-hygiene\n"
            f"  If no skill applies, say so and why:\n"
            f"    Skill: none (reason)"
        )
        return 1

    print(f"check-governance: fleet-shaped ({why}), governed by:")
    for t in citations:
        print(f"  {t}")
    unreasoned = [
        t for t in citations
        if t.split()[0].lower() == "none" and "(" not in t
    ]
    if unreasoned:
        print("check-governance: FAIL, `Skill: none` must carry a reason in parens")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
