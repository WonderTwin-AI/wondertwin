#!/usr/bin/env python3
"""Keep domain engines out of the public kit.

THE FAILURE THIS EXISTS FOR. The ledger engine sat on the public default
branch for months (CTO-46). The tier gate in CI did not catch it, because
that gate reads the dependency graph and so only sees an engine some twin
already USES. An engine re-added with no consumer yet is invisible to it.
This is a presence check instead: it asks what exists under twinkit/, not
what imports it.

WHY AN ALLOWLIST. The obvious shape is a list of banned engine names, and
it cannot work. A list of the nine engines we happen to have deleted does
not catch the tenth under a name nobody has thought of yet, which is the
exact failure it claims to prevent, and it goes stale silently because
nothing fails when someone forgets to extend it. Naming what may exist
inverts that: a new package under twinkit/ fails until somebody adds it
here deliberately, so the decision is forced at the moment it is made
rather than remembered later.

THE RULE, WHICH IS ONE RULE. Every directory that directly contains a .go
file is a Go package. Each one, spelled relative to twinkit/, must be an
exact member of ALLOWED_PACKAGES. The kit root is covered by the same
rule and not a second one: a stray twinkit/ledger.go makes the root a
package whose relative path is "", which is not a member.

Testdata is not exempt, though Go itself ignores it. The exemption that
used to be here matched any path component, so it did not wave through a
fixture, it waved through a subtree: twinkit/ledger/testdata/engine.go
and twinkit/testdata/ledger/engine.go both passed. A genuine testdata
package goes on ALLOWED_PACKAGES by its exact relative path, like any
other package.

WHAT THIS DOES NOT CATCH, SAID PLAINLY. This is a path rule, so it is
package-granular, not file-granular. A single .go file smuggled into a
package that is already allowlisted -- twinkit/twincore/ledger.go, say --
looks exactly like a legitimate file of that package to any path rule,
and no allowlist of paths can tell them apart. That case is left to code
review. What the rule does catch is a new package directory, nested or
top-level, which is the shape an engine actually has and the shape the
ledger arrived in.

WHY THE INDEX, AND WHAT THAT COSTS. This reads git ls-files, not the
worktree. Walking the worktree failed on a .DS_Store, which is line 1 of
this repo's .gitignore and which Finder writes just for opening the
directory, and a gate that cries wolf locally is one people learn to
skip. The cost is the mirror image, and it is real: an engine you have
copied in but not yet git added is invisible here, so a local run can
print green on a tree CI will reject. Stage it first, or CI will see
what your local run did not.

Usage:  scripts/check-engine-boundary
"""

import subprocess
import sys
from pathlib import Path, PurePosixPath

ALLOWED_PACKAGES = frozenset(
    {
        "admin",
        "twincore",
        "state",
        "sim",
        "webhook",
        "testutil",
        "pagination",
        "identity",
        "graphql",
        "grpc",
        "soap",
        "ws",
    }
)

ROOT = Path(__file__).resolve().parent.parent
KIT = "twinkit"


def tracked_files() -> list[PurePosixPath]:
    out = subprocess.run(
        ["git", "-C", str(ROOT), "ls-files", "-z", "--", KIT],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return [PurePosixPath(p) for p in out.split("\0") if p]


def packages() -> dict[str, PurePosixPath]:
    """Map each Go package under the kit to one of its files, for the report."""
    found: dict[str, PurePosixPath] = {}
    for path in tracked_files():
        if path.suffix != ".go":
            continue
        rel = path.parent.relative_to(KIT).as_posix()
        found.setdefault("" if rel == "." else rel, path)
    return found


def main() -> int:
    found = packages()
    if not found:
        print(
            f"check-engine-boundary: FAIL, read no Go packages under {KIT}/.\n"
            f"  An empty read is not a clean kit. Either {ROOT / KIT} is not\n"
            f"  there, or git ls-files returned nothing for it. Refusing to\n"
            f"  report clean on evidence this run does not have."
        )
        return 1

    offenders = sorted(set(found) - ALLOWED_PACKAGES)
    if not offenders:
        print(
            f"check-engine-boundary: {len(found)} Go packages under {KIT}/, "
            f"all allowlisted; no domain engines in the public kit"
        )
        return 0

    print(f"check-engine-boundary: FAIL, unallowlisted Go packages under {KIT}/.")
    for pkg in offenders:
        where = f"{KIT}/{pkg}" if pkg else f"the {KIT}/ root"
        print(f"  {where}  (e.g. {found[pkg]})")
    print(
        "  Domain engines belong in the commercial kit. If one of these is a\n"
        "  primitive the public kit should carry, add its path to "
        f"ALLOWED_PACKAGES\n  in {Path(__file__).name} and say why in the commit."
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
